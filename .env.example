# Copy to .env.local for local development, or set these in the host's environment settings (Vercel > Settings > Environment Variables).
# Every value below is a PLACEHOLDER. Never commit a real key, password or connection string.

# ---------------------------------------------------------------------------------------------
# Local development only
# ---------------------------------------------------------------------------------------------
# Password that `npm run seed` gives all four demo users in the Demo Audit Firm:
#   demo@ledgerfile.test      administrator
#   partner@ledgerfile.test   partner
#   reviewer@ledgerfile.test  reviewer
#   preparer@ledgerfile.test  preparer
# This default is public: never use it outside your own machine. `npm run seed` refuses to run when hosted, and a hosted site
# refuses to sign anyone in with this password.
DEMO_PASSWORD=ledgerfile-demo-only

# ---------------------------------------------------------------------------------------------
# Hosted on Vercel (Neon + Blob). See docs/deploy-vercel.md.
# "Hosted" is on when ANY of DATABASE_URL, LEDGERFILE_HOSTED=1 or VERCEL is set. Hosted with no usable runtime connection refuses to start.
# Lines marked (injected) are set by Vercel or the Neon integration: do not type them in.
# ---------------------------------------------------------------------------------------------
# (injected by Neon) The OWNER's credentials. NOT used as the runtime connection; its presence marks the deployment as hosted.
DATABASE_URL=
# (injected by Neon) The direct owner connection, used by npm run db:setup-hosted.
DATABASE_URL_UNPOOLED=
# (injected by Neon) The pooled host and the database name: the runtime URL is built from these plus ledgerfile_app and the password below.
PGHOST=
PGDATABASE=
# (injected by Neon) The owner's user and password. Only used to refuse a runtime connection as the owner.
PGUSER=
PGPASSWORD=
# (you, secret) Password of the ledgerfile_app login role the app connects as. At least 24 characters. Created by db:setup-hosted.
LEDGERFILE_APP_PASSWORD=<long-random-password>
# (you, secret, optional) Passwords for the invented sample firm seeded by db:setup-hosted. Each at least 10 characters, all different.
SAMPLE_ADMIN_PASSWORD=
SAMPLE_PARTNER_PASSWORD=
SAMPLE_REVIEWER_PASSWORD=
SAMPLE_PREPARER_PASSWORD=
# (you) File storage. Unset locally: a folder under .data. Hosted must choose: vercel-blob, supabase, or local.
FILE_STORE=vercel-blob
# (injected by the Blob store connection) Server-only. Never give these a NEXT_PUBLIC_ prefix.
BLOB_READ_WRITE_TOKEN=
# (you) New firm accounts. Unset: open locally, CLOSED when hosted. 1 opens it, 0 closes it.
SIGNUP_OPEN=
# (you, optional) An explicit runtime database URL that overrides the Neon parts, for another host. It must not be the owner's.
LEDGERFILE_DATABASE_URL=
# (you, optional) Overrides the direct connection used by setup.
DATABASE_URL_MIGRATIONS=
# (you, optional) Connections each server instance keeps (default 3).
DATABASE_POOL_MAX=3
# (you) Set to 1 to run in hosted mode off Vercel.
LEDGERFILE_HOSTED=

# Supabase alternative (docs/deploy-vercel-supabase.md): set LEDGERFILE_DATABASE_URL to the ledgerfile_app transaction-pooler URL, and
# FILE_STORE=supabase with these server-only values:
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=<private-bucket-name>

# ---------------------------------------------------------------------------------------------
# Tests only (the CI `postgres` job sets these; leave unset locally, where tests use PGlite)
# ---------------------------------------------------------------------------------------------
# A role that can CREATE DATABASE: each test file gets its own migrated database on this server.
TEST_DATABASE_URL=
# Optional: an explicit runtime URL for the runtime-role test. Without it the test builds the URL from PGHOST, PGDATABASE and LEDGERFILE_APP_PASSWORD.
TEST_RUNTIME_DATABASE_URL=

# The largest whole-file download in bytes, estimated from stored sizes before it starts (default 1073741824, 1 GB). Above it, download by section.
EXPORT_MAX_BYTES=
