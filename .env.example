# Copy to .env.local for local development, or set these in the host's environment settings (Vercel > Settings > Environment Variables).
# Every value below is a PLACEHOLDER. Never commit a real key, password or connection string.

# ---------------------------------------------------------------------------------------------
# Local development only
# ---------------------------------------------------------------------------------------------
# Password that `npm run seed` gives all four demo users in the Demo Audit Firm:
#   demo@ledgerfile.test      administrator
#   partner@ledgerfile.test   partner
#   reviewer@ledgerfile.test  reviewer
#   preparer@ledgerfile.test  preparer
# This default is public: never use it outside your own machine. `npm run seed` refuses to run when hosted, and a hosted site
# refuses to sign anyone in with this password.
DEMO_PASSWORD=ledgerfile-demo-only

# ---------------------------------------------------------------------------------------------
# Hosted (Vercel + Supabase). See docs/deploy-vercel-supabase.md.
# "Hosted" is on when ANY of DATABASE_URL, LEDGERFILE_HOSTED=1 or VERCEL is set. Hosted without DATABASE_URL refuses to start.
# ---------------------------------------------------------------------------------------------
# Runtime database connection: the Supabase TRANSACTION pooler (port 6543), as the ledgerfile_app login role.
DATABASE_URL=postgres://ledgerfile_app:<password>@<pooler-host>:6543/postgres?sslmode=require
# Connection used only by `npm run db:migrate` and `npm run seed:sample-hosted`: a direct or SESSION-pooler connection (port 5432),
# as the owner role (Supabase: postgres). Falls back to DATABASE_URL if unset.
DATABASE_URL_MIGRATIONS=postgres://postgres:<password>@<direct-host>:5432/postgres?sslmode=require
# Connections each server instance keeps (default 3). Keep it small: every serverless instance has its own pool.
DATABASE_POOL_MAX=3
# Set to 1 to run in hosted mode on a host that is not Vercel and has no DATABASE_URL yet (it will then fail closed).
LEDGERFILE_HOSTED=
# New firm accounts. Unset: open locally, CLOSED when hosted. 1 opens it, 0 closes it.
SIGNUP_OPEN=

# File storage. Unset locally: a folder under .data. Hosted must choose: supabase (or local, on a server with a persistent disk).
FILE_STORE=supabase
# Server-only. Never give these a NEXT_PUBLIC_ prefix: the service role key can read and write every file.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# A PRIVATE bucket. Files are served only through the app's logged download route.
SUPABASE_STORAGE_BUCKET=<private-bucket-name>

# Passwords for `npm run seed:sample-hosted` (the invented sample firm on a hosted demo). Each at least 10 characters, all different,
# and none the public demo password; the seed refuses to run otherwise.
SAMPLE_ADMIN_PASSWORD=
SAMPLE_PARTNER_PASSWORD=
SAMPLE_REVIEWER_PASSWORD=
SAMPLE_PREPARER_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Tests only (the CI `postgres` job sets these; leave unset locally, where tests use PGlite)
# ---------------------------------------------------------------------------------------------
# A role that can CREATE DATABASE: each test file gets its own migrated database on this server.
TEST_DATABASE_URL=
# The runtime login role, connected to a database already migrated and prepared with docs/hosted-roles.sql.
TEST_RUNTIME_DATABASE_URL=
