{
  "name": "ledgerfile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sample": "node scripts/make-sample-tb.mjs && node scripts/make-sample-journals.mjs",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed-demo.mts",
    "seed:sample-hosted": "tsx --env-file-if-exists=.env.vercel scripts/seed-sample-hosted.mts",
    "db:migrate": "tsx --env-file-if-exists=.env.vercel scripts/migrate.mts",
    "db:setup-hosted": "tsx --env-file-if-exists=.env.vercel scripts/setup-hosted.mts",
    "sample:statements": "tsx scripts/sample-statements.mts",
    "methodology": "tsx scripts/build-methodology.mts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@vercel/blob": "^2.9.0",
    "docx": "^9.15.3",
    "exceljs": "^4.4.0",
    "next": "16.4.6",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jszip": "^3.10.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
